export default {
  name: 'foldkit-demo',
  host: '127.0.0.1',
  ports: {
    app: { base: 21880, step: 10 },
  },
  components: {
    app: {
      path: '.',
      worktree: {
        root: '../foldkit-demo.worktrees',
        branchPrefix: 'stack/',
        base: 'HEAD',
      },
      command: ['/bin/sh', 'scripts/start-stack.sh'],
      ports: { http: 'app' },
      env: {
        PORT: '{{ports.app}}',
        SESSION_STATE_DIR: '.local-state',
      },
      url: 'http://{{host}}:{{ports.app}}',
      readiness: { kind: 'http', port: 'app', path: '/', timeoutMs: 180000 },
    },
  },
