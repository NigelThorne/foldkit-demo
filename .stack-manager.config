export default {
  name: 'foldkit-demo',
  host: '127.0.0.1',
  ports: {
    app: { base: 21880, step: 10 },
  },
  components: {
    app: {
      path: '.',
      worktree: {
        root: '../foldkit-demo.worktrees',
        branchPrefix: 'stack/',
        base: 'HEAD',
      },
      command: [
        '/bin/sh',
        '-c',
        'export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"; export MISE_TRUSTED_CONFIG_PATHS="$PWD/mise.toml"; mise exec -- pnpm install --frozen-lockfile && exec mise exec -- pnpm dev:shared',
      ],
      ports: { http: 'app' },
      env: {
        PORT: '{{ports.app}}',
        SESSION_STATE_DIR: '.local-state',
      },
      url: 'http://{{host}}:{{ports.app}}',
      readiness: { kind: 'http', port: 'app', path: '/', timeoutMs: 180000 },
    },
  },
}
